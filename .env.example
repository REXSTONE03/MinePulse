# MinePulse AI Environment Configuration Example
# Copy this file to .env for local development / production configuration

# Application Environment (development, testing, production)
ENV=development

# Database Configuration
# Default (SQLite): sqlite:///./data/minepulse.db
# PostgreSQL Example: postgresql+psycopg2://minepulse_user:CHANGE_ME_PASSWORD@localhost:5432/minepulse_db
DATABASE_URL=sqlite:///./data/minepulse.db

# JWT Security Configuration
# Change JWT_SECRET_KEY to a secure 32+ character random string in production
JWT_SECRET_KEY=CHANGE_ME_MINEPULSE_SUPER_SECRET_JWT_KEY_32_CHARS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:8000,http://localhost:8000

# Model Monitoring & Retraining Configuration
DRIFT_THRESHOLD_PSI=0.25
PERFORMANCE_DEGRADATION_THRESHOLD=0.15
MIN_OBSERVATIONS_FOR_RETRAIN=100
